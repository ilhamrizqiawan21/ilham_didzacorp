# Mencegah listing file
Options -Indexes

# Mencegah akses langsung ke file script berbahaya
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|suspected|cgi|pl|asp|aspx|jsp|sql)$">
    Require all denied
</FilesMatch>

# (Opsional) Mencegah download file dari luar jika ingin lebih privat
# Namun karena siswa perlu melihat file mereka sendiri, biarkan akses baca normal.
# Pastikan tidak ada file berbahaya yang bisa dieksekusi.